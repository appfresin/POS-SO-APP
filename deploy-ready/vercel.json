{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.fresin.id/pos/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fresinapp.vercel.app"
        }
      ],
      "destination": "https://www.fresin.id/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pos-so-app.vercel.app"
        }
      ],
      "destination": "https://www.fresin.id/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pos",
      "destination": "/pos/"
    },
    {
      "source": "/self-order",
      "destination": "/self-order/"
    },
    {
      "source": "/self-order/:path*",
      "destination": "/self-order/"
    }
  ]
}
